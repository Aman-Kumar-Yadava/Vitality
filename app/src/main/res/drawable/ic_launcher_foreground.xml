<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing backdrop (Drop shadow simulation) -->
    <path
        android:pathData="M 54,88 C 30,70 26,55 26,45 C 26,34 35,28 43,28 C 48,28 52,31 54,35 C 56,31 60,28 65,28 C 73,28 82,34 82,45 C 82,55 78,70 54,88 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="51"
                android:gradientRadius="35">
                <item android:offset="0.0" android:color="#40FF5500" />
                <item android:offset="1.0" android:color="#00FF5500" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main stylized heart/pulse shape -->
    <path
        android:pathData="M 54,84 C 30,66 26,51 26,41 C 26,30 35,24 43,24 C 48,24 52,27 54,31 C 56,27 60,24 65,24 C 73,24 82,30 82,41 C 82,51 78,66 54,84 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="26"
                android:startY="24"
                android:endX="82"
                android:endY="84">
                <item android:offset="0.0" android:color="#FFFF8800" />
                <item android:offset="0.5" android:color="#FFFF5500" />
                <item android:offset="1.0" android:color="#FFFF2200" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Left Glass highlight 1 -->
    <path
        android:pathData="M 43,26 C 35,26 29,31 28,39 C 32,31 38,28 43,28 C 46,28 49,30 51,33 C 49,29 46,26 43,26 Z"
        android:fillColor="#90FFFFFF" />

    <!-- Top Right Glass highlight 2 -->
    <path
        android:pathData="M 65,26 C 60,26 57,29 55,33 C 57,30 60,28 65,28 C 70,28 76,31 80,39 C 79,31 73,26 65,26 Z"
        android:fillColor="#90FFFFFF" />
        
    <!-- Bottom Inner Shadow / Ambient occlusion -->
    <path
        android:pathData="M 54,80 C 70,66 76,54 78,45 C 78,53 72,64 54,84 C 36,64 30,53 30,45 C 32,54 38,66 54,80 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="45"
                android:endX="54"
                android:endY="84">
                <item android:offset="0.0" android:color="#00330000" />
                <item android:offset="1.0" android:color="#60330000" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
